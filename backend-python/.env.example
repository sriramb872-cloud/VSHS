# SCHOLARIS backend - environment template.
#
# Copy to `.env` for local development and fill in values.
# In production set these as platform environment variables - NEVER commit
# a filled-in .env file.
#
# NAMES ONLY: no working secrets are stored in this file.

# --- Database --------------------------------------------------------------
# SQLAlchemy URL. MySQL in production; SQLite allowed for tests only.
# Use mysql+pymysql:// in production, e.g.
#   mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# --- Security --------------------------------------------------------------
# REQUIRED. Must be a long random string (>= 32 chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every issued token - treat it like a password.
SECRET_KEY=

# JWT signing algorithm. Only HS256 is supported/validated.
ALGORITHM=HS256

# Access token lifetime (minutes). Short-lived; clients refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime (days). This is the effective "session" length.
REFRESH_TOKEN_EXPIRE_DAYS=14

# Per-account lockout after N consecutive failed logins (never school-wide).
LOGIN_MAX_FAILED_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API.
# NO wildcards. Example:
#   ALLOWED_ORIGINS=https://vshs.vercel.app,https://www.vshs.vercel.app
ALLOWED_ORIGINS=

# Optional fnmatch-style patterns for preview deployments, comma-separated.
# Example: https://*-git-*.vercel.app
ALLOWED_ORIGIN_PATTERNS=

# --- Logging ---------------------------------------------------------------
# json | text
LOG_FORMAT=json
# debug | info | warning | error
LOG_LEVEL=info

# --- Server / process ------------------------------------------------------
# Port to bind (Railway injects PORT; leave alone there).
PORT=8000

# Gunicorn workers. Size with: WEB_CONCURRENCY * DB_POOL_MAX <= MySQL max_connections
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# --- Database connection pool ---------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Rate limiting ---------------------------------------------------------
# slowapi limits applied per client IP (account lockout is separate).
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
DEFAULT_RATE_LIMIT=120/minute

# --- Password reset (forgot password) --------------------------------------
# OTP validity (minutes) and how many wrong codes an account may try.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Single-use reset token lifetime issued after a correct OTP (minutes).
RESET_TOKEN_TTL_MINUTES=10
# Self-service reset requests per login_id AND per IP, per hour.
FORGOT_PASSWORD_PER_HOUR=5

# --- Mail (SMTP) -----------------------------------------------------------
# Needed by the self-service "forgot password" OTP email. Leave SMTP_HOST
# empty to disable email: reset requests then fall back to admin assistance
# instead of failing. Never log or commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Envelope/from address shown to recipients.
MAIL_FROM=

# --- Payments (Razorpay: UPI only, India / INR) -----------------------------

# Which provider handles NEW checkouts:
#   INTERNAL - development mock (hard-disabled when ENVIRONMENT=production)
#   RAZORPAY - real one-time prepaid UPI payments through Razorpay's ORDERS API
PAYMENT_PROVIDER=INTERNAL

# Dashboard -> Settings -> API Keys (start with TEST mode). The key id is
# PUBLIC - the browser needs it to open Checkout.js - so it is the only value
# that may appear in an API response. The two secrets below are server-side
# only: never logged, never serialised, never committed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> "secret". Verified as an HMAC-SHA256
# over the RAW request body (X-Razorpay-Signature) BEFORE anything is written
# to the database.
RAZORPAY_WEBHOOK_SECRET=

# When PAYMENT_PROVIDER=RAZORPAY and ENVIRONMENT=production, startup FAILS
# unless all three RAZORPAY_* values above are set - only the missing NAMES
# are printed, never a value. See docs/PAYMENTS.md.

# --- Web Push (VAPID) --------------------------------------------------------
# Optional. Free, no third-party push service (no Firebase). Generate a key
# pair once (py-vapid ships with pywebpush):
#   python -m py_vapid --gen --version2 --applicationServerKey
# It prints "Application Server Key = <public>" and writes private_key.pem;
# the private key is the base64url string inside that file. Paste both below.
# The app boots with none of these set; push is then disabled and every push
# code path is a no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact claim the push service uses to reach you (mailto: or https:).
VAPID_SUBJECT=mailto:admin@example.com
# Set to false to disable push without removing the keys.
PUSH_ENABLED=
