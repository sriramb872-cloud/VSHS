{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "bash start.sh",
    "restartPolicy": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "overlapSeconds": 30
  }
}
