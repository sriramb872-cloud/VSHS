*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Local database folders
data/
**/data/
database/
**/database/

# Local development storage
storage/
**/storage/

# Temporary exports
exports/
**/exports/


# ============================================================
# 6. USER UPLOADS / GENERATED MEDIA
# ============================================================

