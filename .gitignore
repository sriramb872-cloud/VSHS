# ============================================================
# SCHOLARIS - Root Git Ignore
# React + Vite Frontend / FastAPI Backend
# ============================================================


# ============================================================
# 1. ENVIRONMENT VARIABLES / SECRETS
# ============================================================

# Ignore all environment files everywhere
.env
.env.*
**/.env
**/.env.*

# Allow safe example files
!.env.example
!**/.env.example

# Optional: allow example production config
!.env.production.example
!**/.env.production.example


# ============================================================
# 2. NODE / VITE / FRONTEND
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Vite build output
dist/
**/dist/

# Vercel local configuration
.vercel/
**/.vercel/

# Vite cache
.vite/
**/.vite/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# npm cache
.npm/

# Package manager temporary files
.yarn/
.pnp.*
.pnpm-store/


# ============================================================
# 3. REACT / TYPESCRIPT GENERATED FILES
# ============================================================

# TypeScript incremental build files
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Test snapshots / temporary reports
test-results/
playwright-report/
blob-report/


# ============================================================
# 4. PYTHON / FASTAPI BACKEND
# ============================================================

# Python cache
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python compiled extensions
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/

# Python packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Pip logs/cache
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/


