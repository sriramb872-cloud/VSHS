# Private keys
*.pem
*.key
*.p12
*.pfx
*.jks

# Certificates
*.crt
*.cer
*.csr

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub

# Service account / credential files
service-account*.json
*-service-account*.json
credentials.json
**/credentials*.json

# Firebase / Google credential files
firebase-adminsdk-*.json
google-credentials*.json

# Generic secret files
secrets.json
secret.json
**/secrets.json
**/secret.json

# JWT / auth keys
jwt*.pem
private*.pem


