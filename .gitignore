**/uploads/

# Generated media
media/
**/media/

# Temporary files
tmp/
temp/
**/tmp/
**/temp/

# Generated documents
generated/
**/generated/


# ============================================================
# 7. LOGS
# ============================================================

*.log
logs/
**/logs/

# Backend logs
*.out


